<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：不声明则 queryBroadcastReceivers 查不到 CamCast -->
    <queries>
        <package android:name="io.github.goodbanner.camcast" />
    </queries>

    <application
        android:label="CamProbe"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Probe camera parameters (size/format/fps/id) requested by target apps" />
        <meta-data android:name="xposedminversion" android:value="53" />

        <provider
            android:name=".PresetProvider"
            android:authorities="io.github.goodbanner.camprobe.provider"
            android:exported="true" />

        <receiver
            android:name=".PresetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.goodbanner.camprobe.ACTION_PROBE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
